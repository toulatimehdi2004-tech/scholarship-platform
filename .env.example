# BazaarLink / LLM Configuration
BAZAARLINK_API_KEY=your_bazaarlink_api_key_here
BAZAARLINK_BASE_URL=https://api.bazaarlink.ai/v1
BAZAARLINK_MODEL=qwen/qwen3.7-flash:free

# AI Provider ("auto" | "gemini" | "bazaarlink")
AI_PROVIDER=auto
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Email configuration
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_gmail_app_password

# Django Secret Key (Optional / Production)
# SECRET_KEY=your-secret-key-here
